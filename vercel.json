{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "payiani-technologies.vercel.app" }],
      "destination": "https://payianitechnologies.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.payianitechnologies.com" }],
      "destination": "https://payianitechnologies.com/:path*",
      "permanent": true
    }
  ]
}
